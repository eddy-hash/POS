import { ROLES, type Role } from './roles';

export const PERMISSIONS = {
  VIEW_DASHBOARD: 'view_dashboard',
  VIEW_PRODUCTS: 'view_products',
  CREATE_PRODUCT: 'create_product',
  EDIT_PRODUCT: 'edit_product',
  DELETE_PRODUCT: 'delete_product',
  VIEW_INVENTORY: 'view_inventory',
  MANAGE_INVENTORY: 'manage_inventory',
  VIEW_POS: 'view_pos',
  PROCESS_SALE: 'process_sale',
  VOID_SALE: 'void_sale',
  VIEW_SALES: 'view_sales',
  SALE_READ: 'sale_read',
  SALE_CREATE: 'sale_create',
  SALE_DELETE: 'sale_delete',
  VIEW_CUSTOMERS: 'view_customers',
  MANAGE_CUSTOMERS: 'manage_customers',
  CUSTOMER_READ: 'customer_read',
  CUSTOMER_CREATE: 'customer_create',
  CUSTOMER_UPDATE: 'customer_update',
  CUSTOMER_DELETE: 'customer_delete',
  EXPENSE_READ: 'expense_read',
  EXPENSE_CREATE: 'expense_create',
  EXPENSE_UPDATE: 'expense_update',
  EXPENSE_DELETE: 'expense_delete',
  PURCHASE_READ: 'purchase_read',
  PURCHASE_CREATE: 'purchase_create',
  PURCHASE_DELETE: 'purchase_delete',
  VIEW_REPORTS: 'view_reports',
  VIEW_FINANCIAL_REPORTS: 'view_financial_reports',
  VIEW_USERS: 'view_users',
  VIEW_SUPPLIERS: 'view_suppliers',
  MANAGE_SUPPLIERS: 'manage_suppliers',
} as const;

export type Permission = (typeof PERMISSIONS)[keyof typeof PERMISSIONS];

const MANAGER_PERMS: Permission[] = [
  PERMISSIONS.VIEW_DASHBOARD,
  PERMISSIONS.VIEW_PRODUCTS, PERMISSIONS.CREATE_PRODUCT,
  PERMISSIONS.EDIT_PRODUCT, PERMISSIONS.DELETE_PRODUCT,
  PERMISSIONS.VIEW_INVENTORY, PERMISSIONS.MANAGE_INVENTORY,
  PERMISSIONS.VIEW_POS, PERMISSIONS.PROCESS_SALE, PERMISSIONS.VOID_SALE,
  PERMISSIONS.VIEW_SALES, PERMISSIONS.SALE_READ, PERMISSIONS.SALE_CREATE, PERMISSIONS.SALE_DELETE,
  PERMISSIONS.VIEW_CUSTOMERS, PERMISSIONS.MANAGE_CUSTOMERS,
  PERMISSIONS.CUSTOMER_READ, PERMISSIONS.CUSTOMER_CREATE,
  PERMISSIONS.CUSTOMER_UPDATE, PERMISSIONS.CUSTOMER_DELETE,
  PERMISSIONS.EXPENSE_READ, PERMISSIONS.EXPENSE_CREATE,
  PERMISSIONS.EXPENSE_UPDATE, PERMISSIONS.EXPENSE_DELETE,
  PERMISSIONS.PURCHASE_READ, PERMISSIONS.PURCHASE_CREATE, PERMISSIONS.PURCHASE_DELETE,
  PERMISSIONS.VIEW_REPORTS, PERMISSIONS.VIEW_FINANCIAL_REPORTS,
  PERMISSIONS.VIEW_SUPPLIERS, PERMISSIONS.MANAGE_SUPPLIERS,
  PERMISSIONS.VIEW_USERS,
];

const CASHIER_PERMS: Permission[] = [
  PERMISSIONS.VIEW_DASHBOARD,
  PERMISSIONS.VIEW_PRODUCTS,
  PERMISSIONS.VIEW_POS, PERMISSIONS.PROCESS_SALE,
  PERMISSIONS.VIEW_SALES, PERMISSIONS.SALE_READ, PERMISSIONS.SALE_CREATE,
  PERMISSIONS.VIEW_CUSTOMERS, PERMISSIONS.MANAGE_CUSTOMERS,
  PERMISSIONS.CUSTOMER_READ, PERMISSIONS.CUSTOMER_CREATE, PERMISSIONS.CUSTOMER_UPDATE,
];

export const ROLE_PERMISSIONS: Record<Role, Permission[]> = {
  [ROLES.ADMIN]: Object.values(PERMISSIONS),
  [ROLES.MANAGER]: MANAGER_PERMS,
  [ROLES.CASHIER]: CASHIER_PERMS,
};

export function getPermissionsForRole(role: Role): Permission[] {
  return ROLE_PERMISSIONS[role] ?? [];
}
