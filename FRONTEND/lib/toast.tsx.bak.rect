'use client';

import { useEffect, useRef } from 'react';
import toast, { ToastOptions as ReactHotToastOptions } from 'react-hot-toast';

// ─── Types ───
export type ToastType = 'success' | 'error' | 'warning' | 'info' | 'logout' | 'login';

export interface ToastOptions {
  subMessage?: string;
  duration?: number;
}

// ─── Config ───
const DEFAULT_DURATIONS: Record<ToastType, number> = {
  success: 3000,
  error: 5000,
  warning: 4500,
  info: 4000,
  logout: 2000,
  login: 3000,
};

// ─── Theme: colors used in BOTH light and dark ───
interface ToastTheme {
  // Solid color for the icon chip
  accentBg: string;      // e.g. 'bg-emerald-500'
  // Ring around the card
  ring: string;          // e.g. 'ring-emerald-200 dark:ring-emerald-500/30'
  // Glow shadow in dark mode
  glow: string;
  // Progress bar color
  bar: string;           // e.g. 'bg-emerald-500'
  // The check icon (or custom)
  icon: React.ReactNode;
}

const CheckIcon = (
  <svg className="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none">
    <path
      d="M5 13l4 4L19 7"
      stroke="currentColor"
      strokeWidth="3"
      strokeLinecap="round"
      strokeLinejoin="round"
    />
  </svg>
);

const XIcon = (
  <svg className="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none">
    <path
      d="M9 9l6 6M15 9l-6 6"
      stroke="currentColor"
      strokeWidth="2.6"
      strokeLinecap="round"
    />
  </svg>
);

const WarnIcon = (
  <svg className="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none">
    <path
      d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a1 1 0 00.87 1.5h18.62a1 1 0 00.87-1.5L13.71 3.86a1 1 0 00-1.72 0z"
      stroke="currentColor"
      strokeWidth="2.2"
      strokeLinecap="round"
      strokeLinejoin="round"
    />
  </svg>
);

const InfoIcon = (
  <svg className="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none">
    <path d="M12 11v5.5" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round" />
    <circle cx="12" cy="7.7" r="1.1" fill="currentColor" />
  </svg>
);

const LogoutIcon = (
  <svg className="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none">
    <path
      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
      stroke="currentColor"
      strokeWidth="2.2"
      strokeLinecap="round"
      strokeLinejoin="round"
    />
  </svg>
);

const THEME: Record<ToastType, ToastTheme> = {
  success: {
    accentBg: 'bg-emerald-500',
    ring: 'ring-emerald-200 dark:ring-emerald-500/40',
    glow: 'dark:shadow-[0_24px_60px_-15px_rgba(16,185,129,.55)]',
    bar: 'bg-emerald-500',
    icon: CheckIcon,
  },
  login: {
    accentBg: 'bg-emerald-500',
    ring: 'ring-emerald-200 dark:ring-emerald-500/40',
    glow: 'dark:shadow-[0_24px_60px_-15px_rgba(16,185,129,.55)]',
    bar: 'bg-emerald-500',
    icon: CheckIcon,
  },
  error: {
    accentBg: 'bg-rose-500',
    ring: 'ring-rose-200 dark:ring-rose-500/40',
    glow: 'dark:shadow-[0_24px_60px_-15px_rgba(244,63,94,.55)]',
    bar: 'bg-rose-500',
    icon: XIcon,
  },
  warning: {
    accentBg: 'bg-amber-500',
    ring: 'ring-amber-200 dark:ring-amber-500/40',
    glow: 'dark:shadow-[0_24px_60px_-15px_rgba(245,158,11,.55)]',
    bar: 'bg-amber-500',
    icon: WarnIcon,
  },
  info: {
    accentBg: 'bg-sky-500',
    ring: 'ring-sky-200 dark:ring-sky-500/40',
    glow: 'dark:shadow-[0_24px_60px_-15px_rgba(14,165,233,.55)]',
    bar: 'bg-sky-500',
    icon: InfoIcon,
  },
  logout: {
    accentBg: 'bg-slate-600',
    ring: 'ring-slate-200 dark:ring-slate-500/40',
    glow: 'dark:shadow-[0_24px_60px_-15px_rgba(71,85,105,.55)]',
    bar: 'bg-slate-600',
    icon: LogoutIcon,
  },
};

const ARIA_LIVE: Record<ToastType, 'polite' | 'assertive'> = {
  success: 'polite',
  error: 'assertive',
  warning: 'polite',
  info: 'polite',
  logout: 'polite',
  login: 'polite',
};

// ─── Toast content ───
interface ToastContentProps {
  type: ToastType;
  message: string;
  subMessage?: string;
  id: string;
  visible: boolean;
  duration: number;
}

function ToastContent({ type, message, subMessage, id, visible, duration }: ToastContentProps) {
  const theme = THEME[type];
  const cardRef = useRef<HTMLDivElement>(null);

  // Auto-dismiss — RHT's built-in timer doesn't reliably fire for
  // toast.custom() with our wrapper config, so we handle it ourselves.
  useEffect(() => {
    if (!visible) return;
    const timer = setTimeout(() => toast.dismiss(id), duration);
    return () => clearTimeout(timer);
  }, [id, visible, duration]);

  const handleMouseMove = (e: React.MouseEvent) => {
    if (!cardRef.current) return;
    const r = cardRef.current.getBoundingClientRect();
    const px = (e.clientX - r.left) / r.width - 0.5;
    const py = (e.clientY - r.top) / r.height - 0.5;
    cardRef.current.style.transform = `perspective(900px) rotateX(${py * -5}deg) rotateY(${px * 8}deg)`;
  };

  const handleMouseLeave = () => {
    if (cardRef.current) cardRef.current.style.transform = '';
  };

  return (
    <div
      ref={cardRef}
      role="alert"
      aria-live={ARIA_LIVE[type]}
      onMouseMove={handleMouseMove}
      onMouseLeave={handleMouseLeave}
      className={`
        toast-card pointer-events-auto relative overflow-hidden
        w-[min(92vw,360px)] rounded-2xl
        bg-white dark:bg-slate-800
        ring-1 ${theme.ring} shadow-lg ${theme.glow}
        transition-transform duration-200 ease-out
        ${visible ? 'toast-3d-in' : 'toast-3d-out'}
      `}
      style={{ transformStyle: 'preserve-3d' }}
    >
      {/* Colored top accent */}
      <div className={`absolute inset-x-0 top-0 h-1 ${theme.bar}`} />

      <div className="flex flex-col items-center gap-2 px-5 py-4 text-center">
        {/* Icon chip */}
        <div
          className={`
            flex h-11 w-11 shrink-0 items-center justify-center
            rounded-full ${theme.accentBg}
            shadow-md ring-2 ring-white/60 dark:ring-white/20
          `}
        >
          {theme.icon}
        </div>

        {/* Message */}
        <p className="text-[14px] font-semibold leading-tight text-slate-900 dark:text-white">
          {message}
        </p>

        {/* Sub-message */}
        {subMessage && (
          <p className="text-[12px] leading-snug text-slate-500 dark:text-slate-400">
            {subMessage}
          </p>
        )}
      </div>

      {/* Progress bar — visual countdown, pauses on hover */}
      <div className="h-[3px] w-full bg-slate-100 dark:bg-slate-700">
        <div
          className={`toast-progress h-full ${theme.bar}`}
          style={{ animationDuration: `${duration}ms` }}
        />
      </div>
    </div>
  );
}

// ─── Fire ───
function fire(type: ToastType, message: string, options?: ToastOptions): void {
  const duration = options?.duration ?? DEFAULT_DURATIONS[type];
  toast.custom(
    (t) => (
      <ToastContent
        type={type}
        message={message}
        subMessage={options?.subMessage}
        id={t.id}
        visible={t.visible}
        duration={duration}
      />
    ),
    { duration, position: 'bottom-center', removeDelay: 0 },
  );
}

// ─── Public API ───
export const showSuccessToast = (message: string, subMessage?: string) =>
  fire('success', message, { subMessage });
export const showErrorToast = (message: string, subMessage?: string) =>
  fire('error', message, { subMessage });
export const showWarningToast = (message: string, subMessage?: string) =>
  fire('warning', message, { subMessage });
export const showInfoToast = (message: string, subMessage?: string) =>
  fire('info', message, { subMessage });
export const showLogoutToast = (message: string, subMessage?: string) =>
  fire('logout', message, { subMessage, duration: 2000 });
export const showWelcomeBackToast = (username: string) =>
  fire('login', `Welcome back, ${username}!`, { subMessage: 'Good to see you' });
export const showToast = (type: ToastType, message: string, options?: ToastOptions) =>
  fire(type, message, options);

export const notify = {
  success: (message: string, options?: ToastOptions) => fire('success', message, options),
  error: (message: string, options?: ToastOptions) => fire('error', message, options),
  warning: (message: string, options?: ToastOptions) => fire('warning', message, options),
  info: (message: string, options?: ToastOptions) => fire('info', message, options),
  logout: (message: string, options?: ToastOptions) => fire('logout', message, options),
  welcomeBack: (username: string) =>
    fire('login', `Welcome back, ${username}!`, { subMessage: 'Good to see you' }),
};
