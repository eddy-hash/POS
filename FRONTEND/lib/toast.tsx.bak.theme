'use client';

import { useEffect, useRef } from 'react';
import toast, { ToastOptions as ReactHotToastOptions } from 'react-hot-toast';

// ─── Types ───
export type ToastType = 'success' | 'error' | 'warning' | 'info' | 'logout' | 'login';

export interface ToastOptions {
  subMessage?: string;
  duration?: number;
}

// ─── Config ───
const DEFAULT_DURATIONS: Record<ToastType, number> = {
  success: 3000,
  error: 5000,
  warning: 4500,
  info: 4000,
  logout: 2000,
  login: 3000,
};

// ─── Theme: 3D card look, colored gradients ───
const THEME: Record<
  ToastType,
  {
    gradient: string;
    ring: string;
    glow: string;
    bar: string;
    useCheckmark: boolean;
    svgIcon?: React.ReactNode;
  }
> = {
  success: {
    gradient: 'from-blue-500 via-blue-600 to-blue-700',
    ring: 'ring-blue-300/50',
    glow: 'shadow-[0_24px_60px_-15px_rgba(59,130,246,.65)]',
    bar: 'bg-blue-300',
    useCheckmark: false,
    svgIcon: (
      <svg className="h-5 w-5" viewBox="0 0 24 24" fill="none">
        <path
          d="M5 13l4 4L19 7"
          stroke="currentColor"
          strokeWidth="3"
          strokeLinecap="round"
          strokeLinejoin="round"
        />
      </svg>
    ),
  },
  login: {
    gradient: 'from-blue-500 via-blue-600 to-blue-700',
    ring: 'ring-blue-300/50',
    glow: 'shadow-[0_24px_60px_-15px_rgba(59,130,246,.65)]',
    bar: 'bg-blue-300',
    useCheckmark: false,
    svgIcon: (
      <svg className="h-5 w-5" viewBox="0 0 24 24" fill="none">
        <path
          d="M5 13l4 4L19 7"
          stroke="currentColor"
          strokeWidth="3"
          strokeLinecap="round"
          strokeLinejoin="round"
        />
      </svg>
    ),
  },
  error: {
    gradient: 'from-rose-500 via-rose-600 to-rose-700',
    ring: 'ring-rose-300/50',
    glow: 'shadow-[0_24px_60px_-15px_rgba(244,63,94,.65)]',
    bar: 'bg-rose-300',
    useCheckmark: false,
    svgIcon: (
      <svg className="h-5 w-5" viewBox="0 0 24 24" fill="none">
        <path d="M9 9l6 6M15 9l-6 6" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" />
      </svg>
    ),
  },
  warning: {
    gradient: 'from-amber-500 via-amber-600 to-orange-600',
    ring: 'ring-amber-300/50',
    glow: 'shadow-[0_24px_60px_-15px_rgba(245,158,11,.65)]',
    bar: 'bg-amber-300',
    useCheckmark: false,
    svgIcon: (
      <svg className="h-5 w-5" viewBox="0 0 24 24" fill="none">
        <path
          d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a1 1 0 00.87 1.5h18.62a1 1 0 00.87-1.5L13.71 3.86a1 1 0 00-1.72 0z"
          stroke="currentColor"
          strokeWidth="2.2"
          strokeLinecap="round"
          strokeLinejoin="round"
        />
      </svg>
    ),
  },
  info: {
    gradient: 'from-sky-500 via-sky-600 to-cyan-600',
    ring: 'ring-sky-300/50',
    glow: 'shadow-[0_24px_60px_-15px_rgba(14,165,233,.65)]',
